{
  "meta": {
    "id": "local_planes",
    "description": "Planes + gated shell + CUA session tools. Deny-by-default. Not ambient OS control.",
    "version": 4
  },
  "tools": {
    "plane.status": {
      "description": "Aggregate status of browser-leash + desktop-leash + host",
      "max_blast": 1,
      "allowed_args": [],
      "max_arg_bytes": 256
    },
    "plane.route": {
      "description": "Classify a task string into shell | browser | desktop | mcp-assure | claim-gate",
      "max_blast": 1,
      "required_args": [
        "task"
      ],
      "allowed_args": [
        "task"
      ],
      "max_arg_bytes": 4096
    },
    "browser.status": {
      "description": "browser-leash bridge status",
      "max_blast": 1,
      "allowed_args": [],
      "max_arg_bytes": 256
    },
    "browser.navigate": {
      "description": "Navigate Chrome tab (host allowlist enforced by leash)",
      "max_blast": 2,
      "required_args": [
        "url"
      ],
      "allowed_args": [
        "url"
      ],
      "max_arg_bytes": 2048
    },
    "browser.snapshot": {
      "description": "Active page text snapshot",
      "max_blast": 1,
      "allowed_args": [],
      "max_arg_bytes": 256
    },
    "browser.screenshot": {
      "description": "Capture visible tab",
      "max_blast": 1,
      "allowed_args": [
        "out"
      ],
      "max_arg_bytes": 1024
    },
    "browser.click": {
      "description": "Click selector in Chrome",
      "max_blast": 2,
      "required_args": [
        "selector"
      ],
      "allowed_args": [
        "selector"
      ],
      "max_arg_bytes": 1024
    },
    "browser.type": {
      "description": "Type into selector in Chrome",
      "max_blast": 2,
      "required_args": [
        "text"
      ],
      "allowed_args": [
        "selector",
        "text"
      ],
      "max_arg_bytes": 16384
    },
    "browser.scroll": {
      "description": "Scroll active page",
      "max_blast": 1,
      "allowed_args": [
        "dy",
        "dx"
      ],
      "max_arg_bytes": 256
    },
    "browser.x_draft": {
      "description": "Fill X compose draft (does not publish)",
      "max_blast": 2,
      "required_args": [
        "text"
      ],
      "allowed_args": [
        "text"
      ],
      "max_arg_bytes": 16384,
      "forbidden_args": [
        "token",
        "password",
        "api_key"
      ]
    },
