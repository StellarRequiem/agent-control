      "required_args": [
        "path"
      ],
      "allowed_args": [
        "path"
      ],
      "max_arg_bytes": 1024,
      "forbidden_args": [
        "token",
        "password",
        "api_key"
      ]
    },
    "shell.stat": {
      "description": "Stat path under allowed roots",
      "max_blast": 1,
      "required_args": [
        "path"
      ],
      "allowed_args": [
        "path"
      ],
      "max_arg_bytes": 1024
    },
    "shell.run": {
      "description": "Run named allowlisted command only (no free-form shell)",
