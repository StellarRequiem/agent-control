      "required_args": [
        "x",
        "y"
      ],
      "allowed_args": [
        "x",
        "y"
      ],
      "max_arg_bytes": 256
    },
    "desktop.type": {
      "description": "Type into frontmost allowlisted app (D3)",
      "max_blast": 2,
      "required_args": [
        "text"
      ],
      "allowed_args": [
        "text"
      ],
      "max_arg_bytes": 8192,
      "forbidden_args": [
        "token",
        "password",
        "api_key"
      ]
    },
    "desktop.press": {
