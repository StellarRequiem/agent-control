      "max_blast": 1,
      "required_args": [
        "app",
        "operator_confirm"
      ],
      "allowed_args": [
        "app",
        "operator_confirm"
      ],
      "max_arg_bytes": 256
    },
    "desktop.confirm": {
      "description": "Resolve pending D4 confirm on desktop-leash",
      "max_blast": 1,
      "required_args": [
        "id",
        "approve"
      ],
      "allowed_args": [
        "id",
        "approve"
      ],
      "max_arg_bytes": 512
    },
    "shell.roots": {
      "description": "List allowed workspace roots and named commands",
      "max_blast": 1,
      "allowed_args": [],
      "max_arg_bytes": 256
    },
    "shell.list_dir": {
      "description": "List directory under allowed roots only",
      "max_blast": 1,
      "required_args": [
        "path"
      ],
      "allowed_args": [
        "path"
      ],
      "max_arg_bytes": 1024
    },
    "shell.read_file": {
      "description": "Read file under allowed roots (size-capped, secret-name refuse)",
