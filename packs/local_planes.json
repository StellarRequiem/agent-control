      "required_args": [
        "operator_confirm"
      ],
      "allowed_args": [
        "operator_confirm",
        "click_only",
        "text"
      ],
      "max_arg_bytes": 16384,
      "forbidden_args": [
        "token",
        "password",
        "api_key"
      ]
    },
    "desktop.status": {
      "description": "desktop-leash bridge status",
      "max_blast": 1,
      "allowed_args": [],
      "max_arg_bytes": 256
    },
