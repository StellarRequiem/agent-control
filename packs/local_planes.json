    "cua.stop": {
      "description": "Stop CUA session",
      "max_blast": 1,
      "allowed_args": [
        "reason"
      ],
      "max_arg_bytes": 512
    },
    "cua.status": {
      "description": "CUA session status",
      "max_blast": 1,
      "allowed_args": [],
      "max_arg_bytes": 64
    },
    "cua.observe": {
      "description": "Multi-plane CUA observe",
      "max_blast": 1,
      "allowed_args": [],
      "max_arg_bytes": 64
