{
  "meta": {
    "id": "desktop_app_profiles",
    "description": "Per-app profiles for agent-control + desktop-leash CUA. Modes: strict (default) | cua (wider). Hard denylist always wins.",
    "version": 2
  },
  "mode": "cua",
  "default": {
    "max_input_per_session": 100,
    "allow_type": true,
    "allow_click": true,
    "allow_press": true,
    "allow_quit": false,
    "allow_ax_click": true,
    "notes": "CUA default for allowlisted apps"
  },
  "modes": {
    "strict": {
      "description": "Conservative — editors/dev only",
      "extra_allowlist": []
    },
    "cua": {
      "description": "Wider CUA surface for productive apps; denylist still hard",
      "extra_allowlist": [
        "Visual Studio Code",
        "Slack",
        "Discord",
        "Notion",
        "Obsidian",
        "Calendar",
        "Reminders",
        "Preview",
        "QuickTime Player",
        "zoom.us",
        "Zoom",
        "Microsoft Teams",
        "Spotify",
        "Arc",
        "Brave Browser",
        "Safari Technology Preview",
        "Activity Monitor",
        "Console",
        "Dictionary",
        "Calculator",
        "Books",
        "Photos",
        "Music"
      ]
    }
  },
